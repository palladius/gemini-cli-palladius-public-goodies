#!/bin/bash

# Configuration
TARGET="605724096"
DEFAULT_VOICE="it-IT-GiuseppeNeural"
DEFAULT_SPEED="+25%" # 1.25x
OPENAI_KEY="${OPENAI_API_KEY:-}"

# Simple Logic: if first arg starts with 'it-IT' or is an OpenAI voice, use it
VOICE=$DEFAULT_VOICE
SPEED=$DEFAULT_SPEED

# Quick voice check
case "$1" in
    it-IT-*|echo|onyx|alloy|shimmer|nova|fable)
        VOICE="$1"
        shift
        ;;
esac

# Quick speed check (if it looks like a number or percentage)
if [[ "$1" =~ ^[0-9]+(\.[0-9]+)?x?$ ]] || [[ "$1" =~ ^[+-][0-9]+% ]]; then
    SPEED="$1"
    shift
fi

TEXT="$*"

if [ -z "$TEXT" ]; then
    echo "Usage: octts [voice] [speed] <message>"
    echo "Default: $DEFAULT_VOICE at $DEFAULT_SPEED"
    exit 1
fi

# 1. Extract a clean name from the voice (e.g. it-IT-DiegoNeural -> diego)
VOICE_NAME=$(echo "$VOICE" | sed 's/it-IT-//' | sed 's/Neural//' | tr '[:upper:]' '[:lower:]')

# 2. Generate descriptive filename from text
SAFE_TEXT=$(echo "$TEXT" | tr -dc '[:alnum:]\n ' | tr '[:upper:]' '[:lower:]' | awk '{print $1"_"$2"_"$3}' | sed 's/_$//')
[ -z "$SAFE_TEXT" ] && SAFE_TEXT="audio"

# 3. Combine: voice_name_text_timestamp
TMP_FILE="$HOME/.openclaw/workspace/tmp/${VOICE_NAME}_${SAFE_TEXT}_$(date +%M%S).mp3"

echo "🎙️  Synthesizing with $VOICE (speed: $SPEED)..."
echo "📂  File: $(basename "$TMP_FILE")"

cd "${OPENCLAW_DIR:-$HOME/openclaw}" || exit 1

if [[ "$VOICE" == "echo" || "$VOICE" == "onyx" || "$VOICE" == "alloy" || "$VOICE" == "shimmer" ]]; then
    # OpenAI Path
    if [[ -z "$OPENAI_KEY" ]]; then
        echo "Error: OPENAI_API_KEY environment variable not set." >&2
        exit 1
    fi
    curl -s https://api.openai.com/v1/audio/speech \
      -H "Authorization: Bearer $OPENAI_KEY" \
      -H "Content-Type: application/json" \
      -d "{
        \"model\": \"tts-1\",
        \"input\": \"$TEXT\",
        \"voice\": \"$VOICE\"
      }" \
      --output "$TMP_FILE"
else
    # Edge TTS Path
    node -e "
    import('node-edge-tts').then(async ({EdgeTTS}) => {
        try {
            const tts = new EdgeTTS({voice: '$VOICE', lang: 'it-IT', rate: '$SPEED'});
            await tts.ttsPromise(\"$TEXT\", \"$TMP_FILE\");
            process.exit(0);
        } catch(e) { console.error(e); process.exit(1); }
    }).catch(e => { console.error(e); process.exit(1); });
    "
fi

if [ -s "$TMP_FILE" ]; then
    echo "🚀 Sending via OpenClaw..."
    ./openclaw.mjs message send --channel telegram --target "$TARGET" --media "$TMP_FILE"
    rm -f "$TMP_FILE"
    echo "✅ Done!"
else
    echo "❌ Failed to generate audio."
    exit 1
fi
