# ==========================================
# .env.example — Copy to .env and fill in values
# ==========================================
# ⚠️  NEVER commit .env — only .env.example
# ⚠️  Leave values BLANK here (no placeholders that look like real keys)
# ==========================================

# --- Server ---
PORT=8080
NODE_ENV=development

# --- Database ---
DATABASE_URL=

# --- AI / LLM ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Vector Database ---
PINECONE_API_KEY=
PINECONE_HOST=

# --- Google Cloud ---
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=
GCP_PROJECT_ID=

# --- AWS (if applicable) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Authentication ---
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Communication ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DISCORD_WEBHOOK_URL=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Firebase (client-side, restrict in Cloud Console) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
