# ==============================================================================
# 📓 Gemini Notebook API v1 — Configuration Template (.env.dist)
# ==============================================================================
# Copy this file to `.env` (make sure `.env` is in your `.gitignore`!) and
# configure your consumer Gmail account and GCP Quota Project:
#   cp skills/gemini-notebook-api/.env.dist skills/gemini-notebook-api/.env
# ==============================================================================

# 1. Consumer Google Account (@gmail.com ONLY!)
#    Google Workspace accounts fail with 403 WORKSPACE_ACCOUNT_NOT_SUPPORTED.
GMAIL_ACCOUNT="your.personal.account@gmail.com"

# 2. Personal GCP Project ID where `notebook.googleapis.com` is enabled
#    Used in the mandatory `x-goog-user-project` header on every API call.
QUOTA_PROJECT_ID="your-personal-gcp-project-id"

# 3. Path to your custom Desktop App OAuth 2.0 Client Secret JSON
#    Required to bypass "This app is blocked" when requesting the
#    `https://www.googleapis.com/auth/notebook` scope with `gcloud`.
NOTEBOOK_CLIENT_ID_FILE="~/.config/notebook-api/client_secret.json"

# 4. Isolated gcloud config directory for Notebook API Application Default Credentials
#    Keeps your personal `@gmail.com` token separate from your default `~/.config/gcloud`.
NOTEBOOK_CLOUDSDK_CONFIG="~/.config/gcloud-notebook"

# 5. Optional: Gemini API Key for `notebook_cli.py ask <notebook_id> "<question>"`
# GEMINI_API_KEY="AIzaSy..."
